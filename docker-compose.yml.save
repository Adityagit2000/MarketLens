services:
  db:
    image: timescale/timescaledb:2.13.0-pg15
    container_name: market-intelligence-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: market_intelligence
    ports:
      - "5432:5432"
    volumes:
      - timescaledb_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - market-intelligence-net

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: market-intelligence-backend
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql://postgres:postgres@db:5432/market_intelligence
      DEFAULT_RISK_PER_TRADE: 2.0
      MIN_RISK_REWARD_RATIO: 2.0
      MAX_POSITIONS: 10
      MIN_PROBABILITY_THRESHOLD: 0.60
      MIN_CONFIDENCE_THRESHOLD: 0.65
    ports:
      - "8000:8000"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    networks:
      - market-intelligence-net

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: market-intelligence-frontend
    restart: unless-stopped
    ports:
      - "3000:3000"
    depends_on:
      - backend
    healthcheck:
build:
    context: ./frontend
    dockerfile: Dockerfile
  container_name: market-intelligence-frontend
  restart: unless-stopped
  ports:
    - "3000:3000"
  depends_on:
    - backend
  healthcheck:
    test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000"]
    interval: 30s
    timeout: 10s
    retries: 3
  networks:
    - market-intelligence-net
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000"]
      interval: 30s
      timeout: 10s
      retries: 3
    networks:
      - market-intelligence-net

networks:
  market-intelligence-net:
    driver: bridge

volumes:
  timescaledb_data:
    driver: local
